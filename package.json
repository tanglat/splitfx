{
    "name": "@tanglat/splitfx",
    "version": "1.0.5",
    "description": "JavaScript text animation plugin that splits text into characters and words and animates them.",
    "keywords": [
        "splitfx",
        "javascript",
        "js",
        "text-animation",
        "animate-text",
        "animated-text",
        "js-text-animation",
        "text-animator",
        "split-text",
        "text-splitting",
        "text-effects",
        "text-reveal",
        "typewriter",
        "scroll-animation",
        "animate-on-scroll",
        "text-animation-on-scroll",
        "javascript-text-animation-plugin",
        "vanilla-js",
        "no-dependencies"
    ],
    "author": "Youssef Benghazy",
    "license": "SEE LICENSE IN LICENSE",
    "homepage": "https://splitfx.pages.dev/",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/tanglat/splitfx.git"
    },
    "files": [
        "dist",
        "LICENSE",
        "README.md",
        "CHANGELOG.md"
    ],
    "main": "./dist/umd/splitfx.min.js",
    "module": "./dist/es/splitfx.min.js",
    "browser": "./dist/umd/splitfx.min.js",
    "unpkg": "./dist/umd/splitfx.min.js",
    "jsdelivr": "./dist/umd/splitfx.min.js",
    "exports": {
        ".": {
            "import": "./dist/es/splitfx.min.js",
            "default": "./dist/es/splitfx.min.js"
        }
    },
    "bugs": {
        "url": "https://github.com/tanglat/splitfx/issues"
    }
}